{
  "name": "victoryah",
  "version": "0.1.0",
  "description": "Persistent browser-based multiplayer science-fiction strategy game in a binary star system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddonofrio/victoryah.git"
  },
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/ddonofrio/victoryah/issues"
  },
  "homepage": "https://github.com/ddonofrio/victoryah#readme",
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.170.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "three": "^0.170.0"
  }
}
